[Unit]
Description=Lab Tools Web Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/lab-tools/backend
ExecStart=/var/www/lab-tools/backend/.venv/bin/python run.py
Environment=LAB_TOOLS_HOST=0.0.0.0
Environment=LAB_TOOLS_PORT=8000
Environment=LAB_TOOLS_DATA_DIR=/var/www/lab-tools/backend/data
Environment=LAB_TOOLS_TTL_HOURS=2
# 文档转换：OCR 节点地址与身份（按部署环境修改）
Environment=LAB_TOOLS_OCR_NODE_URL=http://ocr-node:8001
Environment=LAB_TOOLS_OCR_NODE_NAME=ocr-node
Environment=LAB_TOOLS_OCR_NODE_ROLE=heavy
# 文档转换：本地 OCR 模式（true=单机自包含，无需外部 OCR 节点）
Environment=LAB_TOOLS_OCR_USE_LOCAL=false
# 节点身份
Environment=LAB_TOOLS_NODE_NAME=%H
Environment=LAB_TOOLS_NODE_ROLE=main
# 启用工具（逗号分隔，留空则全部启用）
Environment=LAB_TOOLS_ENABLED=
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/lab-tools/backend/data

[Install]
WantedBy=multi-user.target
